#!/usr/bin/env bash

set -euo pipefail

prefix=/orgs/kloudkit/packages/container/

if [ "$1" = pr ] && [ "$2" = view ]; then
  number="$3"
  repo="${5#*/}"
  if [ "${MOCK_FAIL_PR:-}" = "${number}" ]; then
    echo "HTTP 502" >&2
    exit 1
  fi
  [ -f "${MOCK_FX}/pr/${repo}-${number}" ] || { echo "no PR" >&2; exit 1; }
  cat "${MOCK_FX}/pr/${repo}-${number}"
  echo
  exit 0
fi

[ "$1" = api ] || { echo "unexpected gh $*" >&2; exit 2; }
shift

if [ "$1" = --paginate ]; then
  package="${3#"${prefix}"}"
  package="${package%/versions*}"
  if [ "${MOCK_FAIL_LIST:-}" = "${package}" ]; then
    echo "HTTP 403 rate limit" >&2
    exit 1
  fi
  calls="${MOCK_LOG}.${package//\//_}.lists"
  echo x >> "${calls}"
  if [ "$(wc -l < "${calls}")" -eq 1 ]; then
    cat "${MOCK_FX}/${package}.json"
    exit 0
  fi
  if [ "${MOCK_FAIL_RELIST:-}" = "${package}" ]; then
    echo "HTTP 502" >&2
    exit 1
  fi
  jq -c --argjson gone "${MOCK_GONE:-0}" --argjson retag "${MOCK_RETAG:-0}" '
    map(map(select(.id != $gone) | if .id == $retag then .metadata.container.tags = ["dev"] else . end))
  ' "${MOCK_FX}/${package}.json"
  exit 0
fi

if [ "$1" = --method ]; then
  if [ "${MOCK_DELETE_FAIL:-}" = "${3##*/}" ]; then
    echo "gh: Not Found (HTTP 404)" >&2
    exit 1
  fi
  echo "$3" >> "${MOCK_LOG}"
  exit 0
fi

echo "unexpected gh api $*" >&2
exit 2
